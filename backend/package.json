  "private": true,
  "type": "module",
  "description": "Sewika API: authentication, synchronization engine, conflict resolution, outbox to Kafka",
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
