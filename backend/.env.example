# Copy this file to ".env" and change values as needed.

PORT=4000
INSTANCE_ID=api-local
JWT_SECRET=change-this-to-a-long-random-string

# PostgreSQL (primary = writes, replica = analytics/read-only queries)
DATABASE_URL=postgres://ruralhealth:ruralhealth@localhost:5432/ruralhealth
DATABASE_REPLICA_URL=
# Set to true for hosted databases that require SSL (Neon, Render, Supabase)
DATABASE_SSL=false

# Leave empty to run without Kafka (events stay in the outbox table)
KAFKA_BROKERS=
KAFKA_REPLICATION_FACTOR=1

# Leave empty to run without etcd (this instance is always the leader)
ETCD_HOSTS=

# Leave empty to store attachments and backups on local disk instead of MinIO
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Promote the replica automatically when the primary database stops responding
AUTO_FAILOVER=false

# Insert demo users and synthetic patients on first start
SEED_DEMO_DATA=true

# Google sign-in (optional). Paste the OAuth Web Client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=

# Comma separated list of allowed browser origins, or * for any
CORS_ORIGINS=*
